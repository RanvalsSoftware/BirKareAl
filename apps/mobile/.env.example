EXPO_PUBLIC_APP_ENV=development
# Android Emulator: http://10.0.2.2:4000 | iOS Simulator: http://localhost:4000
# Real device: replace with your Mac's LAN address, e.g. http://192.168.1.29:4000
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000
EXPO_PUBLIC_WEB_BASE_URL=http://localhost:3000
EXPO_PUBLIC_SHARE_BASE_URL=http://localhost:3002
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_MINIMUM_USER_AGE=18
# Public contact only; mailbox credentials must never be included in the app.
EXPO_PUBLIC_SUPPORT_EMAIL=birkareal@ranvals.com

# Public OAuth client IDs. These identify the native app; they are not OAuth
# client secrets. Keep secrets exclusively in the server deployment settings.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Google Console calls this the "iOS URL scheme" / "reversed client ID".
# If omitted, app.config.ts derives it from EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Development-only example. Never copy backend secrets into this file or prefix
# them with EXPO_PUBLIC_. Every EXPO_PUBLIC_ value is readable in the app bundle.
# Store builds use EAS "preview" (staging) / "production" environments, with an
# explicit public HTTPS API and support mailbox. See .env.release.example.
# Central local config: from repo root use
# node apps/mobile/scripts/mobile-env.mjs --env-file .env -- npm run start
