# Public, non-secret values embedded in App Store / Play Store binaries.
# Expo loads this file for native Release bundles so a local development URL
# can never be baked into an archive opened directly from Xcode.
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_API_BASE_URL=https://birkare-api.ranvals.com
EXPO_PUBLIC_SUPPORT_EMAIL=birkareal@ranvals.com
# Development-only web/share localhost values from .env must not survive a
# native Release archive. These routes are optional for the current app.
EXPO_PUBLIC_WEB_BASE_URL=
EXPO_PUBLIC_SHARE_BASE_URL=

# These are public SDK/application identifiers, not server credentials.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_MbKttQjNGBgBFiVaQUnwzZHgOce
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_tcWALgjpXQEKKvqBUqhGsfVBaPV
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=197394599682-a7897p3rt9i9ocgbmou6pbf1p3hjrepv.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=197394599682-vnlj6rrm6iq3nshtnikohohiq0q9gpa2.apps.googleusercontent.com
# Android OAuth client for com.birkareai.mobile + Play App Signing SHA-1.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=197394599682-cubvb4e2ajh6621djsrkv3dhbgo6j15p.apps.googleusercontent.com
