# BirKare AI — development-safe defaults. Copy to .env; never commit real credentials.
NODE_ENV=development
APP_NAME=BirKare AI
APP_SLUG=birkare-ai
MOBILE_SCHEME=birkareai
API_HOST=0.0.0.0
API_PORT=4000
API_BASE_URL=http://localhost:4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
TRUST_PROXY=false

# Development starts with memory implementations. Docker/PostgreSQL migration is opt-in.
DATABASE_PROVIDER=memory
DATABASE_URL=postgresql://birkare:birkare@localhost:5432/birkare?schema=public
REDIS_URL=redis://localhost:6379
QUEUE_DRIVER=memory
GENERATION_WORKER_CONCURRENCY=2
# OpenAI provider throughput guardrails (worker-side only).
OPENAI_MAX_JOBS_PER_WINDOW=10
OPENAI_RATE_WINDOW_MS=60000

# No secrets in the mobile app. The fake provider makes the UI flow testable locally.
AI_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_PREMIUM_MODEL=gpt-image-2.5-sunburst
OPENAI_MODERATION_MODEL=omni-moderation-latest
DISABLE_ALL_GENERATION=false
ENABLE_INLINE_WORKER=true

# Local storage is only for development. Production requires Cloudflare R2.
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=../../.local-storage
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Set strong, unique values before staging/production. They are deliberately not mobile values.
JWT_ISSUER=http://localhost:4000
JWT_USER_AUDIENCE=birkare-mobile
JWT_ACCESS_SECRET=development-only-secret-change-before-production-0001
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_PEPPER=development-only-pepper-change-before-production
AUTH_DEV_MODE=true

# E-mail registration security. Apple Hide My Email must remain allowed.
# Add domains only after a deliberate review; never use this as a public-provider
# allowlist because legitimate corporate domains are validated by MX records.
EMAIL_DOMAIN_ALLOWLIST=privaterelay.appleid.com
EMAIL_DOMAIN_BLOCKLIST=

# Transactional email is backend-only. Gmail requires an App Password (not the
# account password) or an OAuth2-capable provider. Never put secrets in EXPO_PUBLIC.
# Local private SMTP overrides may live in .local-credentials/deployment/mail.env.
MAIL_DRIVER=disabled
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=BirKare AI
MAIL_APP_SCHEME=birkareai
ACCOUNT_DELETION_WEB_URL=http://localhost:3000/birkare/hesap-silme/
SUPPORT_EMAIL=birkareal@ranvals.com

# Social login — iOS and Web client IDs default to BirKare's public Google
# registrations when left blank. OAuth client IDs are safe here, but never put
# an OAuth client secret, Apple private key, keystore, or service-account JSON
# in this file. See docs/google-cloud-auth-setup.md for the exact Console values.
GOOGLE_IOS_CLIENT_ID=
# Set this only after creating a distinct Android OAuth client. Android native
# sign-in may target GOOGLE_WEB_CLIENT_ID as its server client ID.
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
APPLE_BUNDLE_ID=com.birkareai.mobile

# RevenueCat server verification. The secret REST key and the random webhook
# authorization token belong only to API/worker runtime environments.
REVENUECAT_ENABLED=false
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH_TOKEN=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
REVENUECAT_ENTITLEMENT_ID=create_an_app_called_birkare_pro
REVENUECAT_OFFERING_ID=birkare_pro
REVENUECAT_MONTHLY_PRODUCT_IDS=monthly,com.birkareai.pro.monthly
REVENUECAT_ANNUAL_PRODUCT_IDS=yearly,com.birkareai.pro.yearly
REVENUECAT_LIFETIME_PRODUCT_IDS=lifetime,com.birkareai.pro.lifetime
REVENUECAT_MONTHLY_CREDITS=80
REVENUECAT_ANNUAL_MONTHLY_CREDITS=80
REVENUECAT_LIFETIME_CREDITS=200
REVENUECAT_REQUEST_TIMEOUT_MS=8000
REVENUECAT_CACHE_TTL_MS=30000

# Expo public values may be inspected in the shipped application. Do not add secrets here.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_SUPPORT_EMAIL=birkareal@ranvals.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# RevenueCat public SDK values. iOS development uses the configured App Store
# app key; Android development may use the built-in Test Store key while blank.
# Never put sk_ secrets, webhook tokens, or Apple .p8 files here.
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=birkare_pro
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
