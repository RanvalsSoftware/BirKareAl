# BirKare API + worker / Cloud SQL + Portainer Redis.
# Copy values to Portainer Stack > Environment variables, or a private env file.
# Never include real secrets in Git, Docker build args, image layers, or mobile.
# The first deployment below is STAGING; production needs separate DB/R2/secrets.
IMAGE_TAG=2026.09.08-2
NODE_ENV=staging
API_BIND_ADDRESS=127.0.0.1
API_PUBLISHED_PORT=4000
LOG_LEVEL=info
TRUST_PROXY=false

# Rıdvan creates this DB/user in Cloud SQL; these fields do not create a DB.
# The compose stack builds DATABASE_URL through the Cloud SQL Auth Proxy.
DB_NAME=birkare_staging
DB_USER=
DB_PASSWORD=
# Example: project:region:instance
CLOUD_SQL_INSTANCE_CONNECTION_NAME=
# Absolute path on the Portainer host to a least-privilege service-account JSON.
CLOUD_SQL_CREDENTIALS_FILE=
# The proxy provides the encrypted Cloud SQL connection; app traffic uses sslmode=disable locally.

# Generate at least 32 random URL-safe characters; no published Redis port.
REDIS_PASSWORD=

# Actual HTTPS API issuer and permitted web origins (not wildcard).
JWT_ISSUER=
CORS_ORIGINS=
JWT_ACCESS_SECRET=
PASSWORD_PEPPER=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Registration abuse controls. Apple Private Relay is intentionally allowed;
# corporate domains are accepted after MX validation.
EMAIL_DOMAIN_ALLOWLIST=privaterelay.appleid.com
EMAIL_DOMAIN_BLOCKLIST=

# Required in staging/production: private R2 bucket, least-privilege credentials.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Keep false for R2 deployments. Set true only for the single-host Portainer
# compose, which uses the shared birkare-storage Docker volume instead of R2.
ALLOW_LOCAL_STORAGE=false

AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_PREMIUM_MODEL=gpt-image-2.5-sunburst
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_MODERATION_MODEL=omni-moderation-latest
# Operator enables generation only after deployment acceptance checks.
DISABLE_ALL_GENERATION=false
GENERATION_WORKER_CONCURRENCY=1
OPENAI_MAX_JOBS_PER_WINDOW=2
OPENAI_RATE_WINDOW_MS=60000

GOOGLE_WEB_CLIENT_ID=197394599682-a7897p3rt9i9ocgbmou6pbf1p3hjrepv.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=197394599682-vnlj6rrm6iq3nshtnikohohiq0q9gpa2.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=
APPLE_BUNDLE_ID=com.birkareai.mobile

# RevenueCat backend verification (never EXPO_PUBLIC and never baked into images).
REVENUECAT_ENABLED=true
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH_TOKEN=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
REVENUECAT_ENTITLEMENT_ID=create_an_app_called_birkare_pro
REVENUECAT_OFFERING_ID=birkare_pro
REVENUECAT_MONTHLY_PRODUCT_IDS=monthly,com.birkareai.pro.monthly
REVENUECAT_ANNUAL_PRODUCT_IDS=yearly,com.birkareai.pro.yearly
REVENUECAT_LIFETIME_PRODUCT_IDS=lifetime,com.birkareai.pro.lifetime
REVENUECAT_MONTHLY_CREDITS=80
REVENUECAT_ANNUAL_MONTHLY_CREDITS=80
REVENUECAT_LIFETIME_CREDITS=200

# Transactional e-mail is backend-only. For Gmail, use a dedicated App Password,
# never the mailbox's normal login password. Port 587 requires SMTP_SECURE=false;
# port 465 requires SMTP_SECURE=true.
MAIL_DRIVER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=BirKare AI
MAIL_APP_SCHEME=birkareai
SUPPORT_EMAIL=birkareal@ranvals.com
# Do not reuse the mailbox password for PostgreSQL, Redis, JWT, or GitHub.
